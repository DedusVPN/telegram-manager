BOT_TOKEN=your_bot_token_from_botfather
API_ID=your_api_id_from_my.telegram.org
API_HASH=your_api_hash_from_my.telegram.org
ENCRYPTION_KEY=generate_with_uv_run_python_scripts_generate_key.py

# Telegram bot: ID администраторов через запятую (узнать у @userinfobot)
ADMIN_IDS=123456789

# Только для локальной разработки — отключает проверки небезопасных значений
ALLOW_INSECURE=false

# Web platform
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_PASSWORD=your_strong_password_here
WEB_SECRET=generate_random_secret_at_least_32_chars
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
